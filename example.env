# Required webhook authentication token.
WEBHOOK_TOKEN=replace-with-a-long-random-token

# Required speech-to-text endpoint and model.
STT_URL=http://audio-cpp:8080/v1/audio/transcriptions
STT_MODEL_NAME=qwen3-asr-1.7b-q8_0

# Local LLM for the router service (intent classification).
# LLM_URL is the OpenAI-compatible API base of your llama.cpp server.
# Only required once the router service (plan step 6) is running.
LLM_URL=http://localhost:8080/v1
LLM_MODEL_NAME=

# HTTP POST destination for classified voice notes. It must accept JSON with
# note_id, transcript, and intent fields.
DISPATCH_WEBHOOK_URL=https://workflow.example.com/dispatch
# Optional static auth header. Set both values or leave both empty.
# For Bearer auth: Authorization / Bearer replace-with-secret
# For an API key: X-API-Key / replace-with-secret
DISPATCH_WEBHOOK_AUTH_HEADER=
DISPATCH_WEBHOOK_AUTH_VALUE=

# Pushover lifecycle notifications. Use mode=off to disable and omit credentials.
# Create an application token at pushover.net/apps and use your user key.
NOTIFICATION_MODE=normal
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# Docker Compose: host directory mounted into the containers at /data.
HOST_DATA_DIR=./data

# Application storage for direct local runs. It defaults to ./data, and Compose
# sets it to /data inside the containers. DATABASE_PATH defaults to
# $DATA_DIR/koemichi.db when unset.
# DATA_DIR=./data
# DATABASE_PATH=
TZ=Europe/Berlin
