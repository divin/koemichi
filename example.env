# Shared secret: transcript senders authenticate with this Bearer token.
TRANSCRIPT_INGEST_TOKEN=replace-with-a-separate-long-random-service-token

# NoteDiscovery API used by memo/journal workflows and read-only MCP tools.
NOTEDISCOVERY_API_URL=http://host.docker.internal:8000

# Local LLM endpoint for intent fallback.
LLM_URL=http://llama-cpp:8080/v1
LLM_MODEL_NAME=your-model-name

# Pushover lifecycle notifications; set mode=off to omit credentials.
NOTIFICATION_MODE=normal
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# Receiver host port and Koemichi data directory.
KOEMICHI_PORT=8001
HOST_DATA_DIR=./data
# DATABASE_PATH defaults to ${DATA_DIR}/koemichi.db.
TZ=Europe/Berlin
