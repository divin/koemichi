# Optional. Leave unset for trusted localhost-only use; otherwise use a long random secret.
# TRANSCRIPT_INGEST_TOKEN=replace-with-a-separate-long-random-service-token

# NoteDiscovery API used by memo/journal workflows and read-only MCP tools.
NOTEDISCOVERY_API_URL=http://host.docker.internal:8000

# Vikunja used by the todo workflow and its MCP tools. The project is the
# dedicated inbox all voice-captured todos are added to. The token needs the
# mcp:access scope so the agent can call Vikunja's built-in MCP server.
VIKUNJA_API_URL=http://host.docker.internal:9019
VIKUNJA_API_TOKEN=tk_...
VIKUNJA_PROJECT_ID=1
# Optional: overrides the MCP endpoint, which defaults to
# ${VIKUNJA_API_URL}/api/v2/mcp.
# VIKUNJA_MCP_URL=http://host.docker.internal:9019/api/v2/mcp

# Local LLM endpoint for intent fallback.
LLM_URL=http://llama-cpp:8080/v1
LLM_MODEL_NAME=your-model-name

# Pushover lifecycle notifications; set mode=off to omit credentials.
NOTIFICATION_MODE=normal
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# Receiver host port and Koemichi data directory.
KOEMICHI_PORT=8001
HOST_DATA_DIR=./data
# DATABASE_PATH defaults to ${DATA_DIR}/koemichi.db.
TZ=Europe/Berlin
